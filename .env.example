# CL-01 Environmental Intelligence Platform - Environment Configuration

# Optional: Cesium Ion Access Token
VITE_CESIUM_ION_TOKEN=

# API base URL — used by the frontend API client (src/api/client.ts)
# In development, Vite proxies /api/* to localhost:8000 automatically.
# Override this only when deploying to a non-local backend.
VITE_API_BASE_URL=http://localhost:8000

# Frontend dev server port
VITE_PORT=5173

# ─────────────────────────────────────────────────────────────────────────────
# Sentinel-2 Satellite Data Ingestion — Backend Provider Credentials
# Read ONLY by the backend (never exposed to frontend, never commit real secrets)
# ─────────────────────────────────────────────────────────────────────────────
# Copernicus Data Space Ecosystem (CDSE) OAuth2 / API Credentials:
# Register at: https://dataspace.copernicus.eu/
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_USERNAME=
CDSE_PASSWORD=

# Optional: Generic satellite provider or STAC API bearer key
SATELLITE_PROVIDER_API_KEY=

# Local directory where satellite GeoTIFFs and metadata outputs are cached
# Defaults to backend/data/satellite_outputs
SATELLITE_DATA_DIR=backend/data/satellite_outputs
