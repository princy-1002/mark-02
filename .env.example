# CL-01 Environmental Intelligence Platform - Environment Configuration

# Optional: Cesium Ion Access Token
# If provided, enables high-resolution Cesium Ion World Terrain (water masks & vertex normals)
# and Cesium Ion satellite imagery streaming.
# If omitted or empty, the application automatically falls back to permitted
# Esri World Imagery (MapServer 15m/sub-meter) and OpenStreetMap tiles with Ellipsoid terrain.
VITE_CESIUM_ION_TOKEN=

# API Port & Host Configuration
VITE_PORT=5174
