# CL-01 Environmental Intelligence Platform - Environment Configuration

# Optional: Cesium Ion Access Token
VITE_CESIUM_ION_TOKEN=

# API base URL — used by the frontend API client (src/api/client.ts)
# In development, Vite proxies /api/* to localhost:8000 automatically.
# Override this only when deploying to a non-local backend.
VITE_API_BASE_URL=http://localhost:8000

# Frontend dev server port
VITE_PORT=5173
